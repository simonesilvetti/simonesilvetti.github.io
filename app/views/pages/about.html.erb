  <%# The text is in content/pages/about.md %>
  <div class="prose mt-6 max-w-none">
    <%= @page.html %>

    <h2>Contact</h2>
  </div>

  <div class="mt-4">
    <%= render "shared/social_links" %>
  </div>
</div>
