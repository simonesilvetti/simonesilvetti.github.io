<% content_for :title, "Papers" %>
<% content_for :description, "Publications on temporal logics, runtime monitoring, machine learning and the verification of cyber-physical systems." %>

<section class="mt-8">
  <h1 class="text-2xl font-semibold sm:text-3xl">Papers</h1>
  <p class="mt-2 mb-6 italic">The papers I've written.</p>

  <% @papers.group_by { it.date.year }.each do |year, papers| %>
    <h2 class="mt-12 text-xl font-semibold tracking-wide"><%= year %></h2>
    <ul>
      <%= render partial: "papers/paper", collection: papers %>
    </ul>
  <% end %>
</section>
