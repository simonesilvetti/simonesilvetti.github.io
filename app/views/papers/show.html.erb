<% content_for :title, @paper.title %>
<% content_for :description, @paper.description %>

<div class="mt-8">
  <%= link_to "← All papers", papers_path, class: "mb-4 inline-block opacity-80 hover:text-accent" %>

  <h1 class="text-2xl font-bold text-accent sm:text-3xl"><%= @paper.title %></h1>
  <p class="mt-3 opacity-80"><%= paper_authors(@paper) %></p>
  <p class="mt-2 text-sm italic opacity-80">
    <%= @paper.venue %>, <%= @paper.date.year %><% if @paper.pages.present? %> · pp. <%= @paper.pages %><% end %>
  </p>
  <% if @paper.url %>
    <p class="mt-2 text-sm">
      <%= link_to "Read the paper →", @paper.url, class: "underline decoration-dashed underline-offset-4 hover:text-accent" %>
    </p>
  <% end %>

  <article class="prose mt-6 max-w-none">
    <%= @paper.html %>
  </article>

  <hr class="my-8 border-border">
  <%= link_to "← All papers", papers_path, class: "opacity-80 hover:text-accent" %>
</div>
